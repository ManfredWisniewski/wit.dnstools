#!/usr/bin/env python3
import json
import os
import shutil
import tempfile
import urllib.request
from datetime import datetime, timezone

ENDPOINT = os.environ.get("NETCUP_ENDPOINT", {{ netcup_endpoint | to_json }})
ENV_FILE = os.environ.get(
    "NETCUP_ENV_FILE", {{ netcup_domain_export_credentials_file | to_json }}
)
OUTPUT_FILE = {{ (netcup_domain_export_output_dir ~ '/' ~ netcup_domain_export_filename) | to_json }}
OWNER = {{ file_ownership.split('/')[0] | to_json }}
GROUP = {{ file_ownership.split('/')[1] | to_json }}
MODE = {{ netcup_domain_export_file_mode | to_json }}


def load_environment(path):
    values = {}
    with open(path, encoding="utf-8") as env_file:
        for raw_line in env_file:
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            values[key.strip()] = value
    return values


def api_call(action, params):
    payload = json.dumps({"action": action, "param": params}).encode("utf-8")
    request = urllib.request.Request(
        ENDPOINT,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        result = json.load(response)
    if result.get("status") != "success":
        message = result.get("longmessage") or result.get("shortmessage") or action
        raise RuntimeError(f"Netcup API {action} failed: {message}")
    return result.get("responsedata", {})


def response_items(data, keys):
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for key in keys:
            if isinstance(data.get(key), list):
                return data[key]
    return []


def domain_name(domain):
    if isinstance(domain, str):
        return domain
    for key in ("domainname", "domain", "name"):
        if domain.get(key):
            return domain[key]
    return ""


def record_value(record, key, default=""):
    value = record.get(key, default)
    return default if value is None else str(value)


def table_rows(credentials):
    login = api_call(
        "login",
        {
            "customernumber": credentials["NETCUP_CUSTOMER_NUMBER"],
            "apikey": credentials["NETCUP_API_KEY"],
            "apipassword": credentials["NETCUP_API_PASSWORD"],
        },
    )
    session_id = login["apisessionid"]
    common = {
        "customernumber": credentials["NETCUP_CUSTOMER_NUMBER"],
        "apikey": credentials["NETCUP_API_KEY"],
        "apisessionid": session_id,
    }
    try:
        domains_data = api_call("listallDomains", common)
        domains = sorted(
            {domain_name(item) for item in response_items(domains_data, ("domains", "domain"))}
            - {""}
        )
        rows = []
        for domain in domains:
            records_data = api_call(
                "infoDnsRecords", {**common, "domainname": domain}
            )
            records = response_items(records_data, ("dnsrecords", "records"))
            for record in records:
                rows.append(
                    (
                        domain,
                        record_value(record, "hostname", "@"),
                        record_value(record, "type"),
                        record_value(record, "destination"),
                        record_value(record, "priority", "0"),
                        record_value(record, "ttl"),
                        record_value(record, "state"),
                    )
                )
        return rows
    finally:
        api_call("logout", common)


def markdown_value(value):
    return str(value).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def render(rows):
    lines = [
        "# Domains and DNS records",
        " This file is automatically generated daily by wit.dnstools. Do not edit manually!",
        f"Generated: {datetime.now(timezone.utc).isoformat()}",
        "",
        "## Netcup domains",
        "| Domain | Destination |",
        "| --- | --- |",
    ]
    for row in rows:
        if row[1] != "*":
            continue
        simple = " | ".join(markdown_value(value) for value in (row[0], row[3]))
        lines.append(f"| {simple} |")
    lines.extend([
        "",
        "",
        "### Netcup DNS details",
        "| Domain | Subdomain | Type | Destination | Priority | TTL | State |",
        "| --- | --- | --- | --- | ---: | ---: | --- |",
    ])
    for row in rows:
        cells = " | ".join(markdown_value(value) for value in row)
        lines.append(f"| {cells} |")
    lines.append("")
    return "\n".join(lines)


def main():
    credentials = load_environment(ENV_FILE)
    required = (
        "NETCUP_CUSTOMER_NUMBER",
        "NETCUP_API_KEY",
        "NETCUP_API_PASSWORD",
    )
    missing = [key for key in required if not credentials.get(key)]
    if missing:
        raise RuntimeError(f"Missing variables in {ENV_FILE}: {', '.join(missing)}")

    content = render(table_rows(credentials))
    directory = os.path.dirname(OUTPUT_FILE) or "."
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=directory, delete=False
    ) as output:
        output.write(content)
        temporary_file = output.name
    os.replace(temporary_file, OUTPUT_FILE)
    os.chmod(OUTPUT_FILE, int(MODE, 8))
    shutil.chown(OUTPUT_FILE, user=OWNER, group=GROUP)


if __name__ == "__main__":
    main()
